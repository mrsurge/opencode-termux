{
  "schema_version": 1,
  "compat": {
    "app_server_manifest_min": 1,
    "app_server_manifest_max": 1
  },
  "id": "opencode-app-server",
  "name": "OpenCode App Server",
  "version": "0.1.0",
  "type": "opencode_app_server",
  "description": "OpenCode route-backed app-server test harness over strict JSON-RPC stdio",
  "enabled": true,
  "agent": {
    "command": "/data/data/com.termux/files/home/.bun/bin/bun",
    "args": [
      "run",
      "--conditions=browser",
      "/data/data/com.termux/files/home/test-projects/opencode/packages/opencode/src/index.ts",
      "app-server"
    ],
    "shellspec": "shellspec/opencode_app_server.yaml#opencode_app_server_observed"
  },
  "capabilities": {
    "sessionResume": true,
    "streaming": true,
    "modelListing": true,
    "permissionHandling": true,
    "live_session_request": true,
    "collabAgents": false,
    "hasPlan": false,
    "hasTodo": true,
    "hasPlanModes": false
  },
  "model": {
    "name": "opencode-auto",
    "provider": "opencode"
  },
  "ui": {
    "icon": "opencode.svg",
    "color": "#4285f4",
    "semanticShellRibbon": {
      "quoteParsing": true
    },
    "toolRenderPolicy": {
      "default": {
        "args": "plain",
        "result": "plain"
      },
      "rules": [
        {
          "server": "agent-pty-blocks",
          "tool": "agent_log_post",
          "requestFields": {
            "message": "markdown"
          }
        },
        {
          "server": "agent-pty-blocks",
          "tool": "agent_log_post_await",
          "requestFields": {
            "message": "markdown"
          }
        },
        {
          "server": "agent-pty-blocks",
          "toolPrefix": "agent_log_",
          "response": "markdown"
        },
        {
          "server": "agent-pty-blocks",
          "tool": "kb_write",
          "requestFields": {
            "content": "markdown"
          }
        },
        {
          "server": "agent-pty-blocks",
          "tool": "kb_update",
          "requestFields": {
            "content": "markdown"
          }
        },
        {
          "server": "agent-pty-blocks",
          "toolPrefix": "kb_",
          "response": "markdown"
        },
        {
          "server": "te2-mcp",
          "tool": "te2_console_eval",
          "requestFields": {
            "target_worker_id": "plain",
            "code": {
              "kind": "hljs",
              "language": "javascript"
            }
          },
          "responseFields": {
            "workerId": "plain",
            "reqId": "plain",
            "ok": "plain",
            "value": {
              "kind": "hljs",
              "language": "json"
            }
          }
        }
      ]
    },
    "requestCards": [
      {
        "id": "opencode-app-server-approval",
        "module": "ui/request_cards/opencode_app_server_request_card.js",
        "export": "renderRequestCard",
        "matches": [
          {
            "requestMethod": "turn/toolApprovalRequested"
          },
          {
            "requestMethod": "turn/userInputRequested",
            "kind": "user_input"
          }
        ]
      }
    ]
  }
}
