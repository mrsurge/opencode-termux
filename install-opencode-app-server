#!/usr/bin/env bash
set -euo pipefail

APP="opencode-app-server"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PACKAGE_DIR="$REPO_ROOT/packages/opencode"
INSTALL_DIR="${OPENCODE_APP_SERVER_INSTALL_DIR:-$HOME/.local/bin}"
BASHRC="${OPENCODE_APP_SERVER_BASHRC:-$HOME/.bashrc}"

usage() {
  cat <<EOF
OpenCode app-server binary installer

Usage: ./install-opencode-app-server [options]

Options:
  -h, --help              Show this help message.
      --install-dir DIR   Install the compiled binary into DIR.
      --build-arg ARG     Pass one additional argument to packages/opencode/script/build.ts.

Environment:
  OPENCODE_APP_SERVER_INSTALL_DIR  Install directory. Defaults to \$HOME/.local/bin.
  OPENCODE_APP_SERVER_BASHRC       Shell rc file to update. Defaults to \$HOME/.bashrc.

This script uses the first bun found in PATH, builds the self-contained OpenCode
binary for the current platform, and installs that binary as:

  \$OPENCODE_APP_SERVER_INSTALL_DIR/opencode-app-server

The installed binary uses the normal OpenCode CLI entrypoint. Start the stdio
app-server with:

  opencode-app-server app-server
EOF
}

build_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --install-dir)
      if [[ -z "${2:-}" ]]; then
        echo "Error: --install-dir requires a directory." >&2
        exit 1
      fi
      INSTALL_DIR="$2"
      shift 2
      ;;
    --build-arg)
      if [[ -z "${2:-}" ]]; then
        echo "Error: --build-arg requires a value." >&2
        exit 1
      fi
      build_args+=("$2")
      shift 2
      ;;
    *)
      echo "Error: unknown option '$1'." >&2
      exit 1
      ;;
  esac
done

if ! command -v bun >/dev/null 2>&1; then
  echo "Error: bun must be installed and available in PATH." >&2
  exit 1
fi

if [[ ! -d "$PACKAGE_DIR" ]]; then
  echo "Error: packages/opencode was not found under $REPO_ROOT." >&2
  exit 1
fi

mkdir -p "$INSTALL_DIR"

cd "$REPO_ROOT"
bun install --frozen-lockfile

cd "$PACKAGE_DIR"
bun run script/build.ts --single "${build_args[@]}"

mapfile -t candidates < <(find "$PACKAGE_DIR/dist" -path "*/bin/opencode" -type f | sort)
if [[ "${#candidates[@]}" -ne 1 ]]; then
  echo "Error: expected exactly one compiled opencode binary, found ${#candidates[@]}." >&2
  printf '%s\n' "${candidates[@]}" >&2
  exit 1
fi

cp "${candidates[0]}" "$INSTALL_DIR/$APP"
chmod 755 "$INSTALL_DIR/$APP"

case ":$PATH:" in
  *":$INSTALL_DIR:"*) ;;
  *)
    mkdir -p "$(dirname "$BASHRC")"
    touch "$BASHRC"
    if ! grep -F "export PATH=\"$INSTALL_DIR:\$PATH\"" "$BASHRC" >/dev/null 2>&1; then
      {
        printf '\n'
        printf '# Added by OpenCode app-server installer\n'
        printf 'export PATH="%s:$PATH"\n' "$INSTALL_DIR"
      } >> "$BASHRC"
    fi
    echo "Added $INSTALL_DIR to PATH in $BASHRC. Restart your shell or source that file."
    ;;
esac

echo "Installed $APP to $INSTALL_DIR/$APP"
echo "Run app-server mode with: $APP app-server"
